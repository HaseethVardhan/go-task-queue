POSTGRES_USER=gotask
POSTGRES_PASSWORD=gotask_dev_password
POSTGRES_DB=gotask
POSTGRES_PORT=5432

# Go application running directly on Windows
DATABASE_URL=postgres://gotask:gotask_dev_password@localhost:5432/gotask?sslmode=disable

# Migration tool running inside Docker
MIGRATE_DATABASE_URL=postgres://gotask:gotask_dev_password@postgres:5432/gotask?sslmode=disable